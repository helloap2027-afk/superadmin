{
  "name": "hello-platform",
  "version": "1.0.0",
  "private": true,
  "description": "HELLO — Hyperlocal Business Discovery & Instant Enquiry Platform",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "format": "prettier --write \"**/*.{ts,tsx,js,json,md}\""
  },
  "devDependencies": {
    "turbo": "^2.2.3",
    "typescript": "^5.6.3",
    "@types/node": "^20.14.0",
    "prettier": "^3.3.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@nestjs/core",
      "@prisma/client",
      "@prisma/engines",
      "prisma"
    ]
  },
  "packageManager": "pnpm@12.15.0"
}
