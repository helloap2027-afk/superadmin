// HELLO Platform — MariaDB / MySQL Relational Schema
datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// -------------------------------------------------------------
// 1. IDENTITY & SESSIONS
// -------------------------------------------------------------

enum UserStatus {
  ACTIVE
  SUSPENDED
  DELETED
}

model User {
  id               String       @id @default(uuid()) @db.VarChar(36)
  phoneNumber      String       @unique(map: "uk_users_phone") @map("phone_number") @db.VarChar(15)
  fullName         String?      @map("full_name") @db.VarChar(100)
  email            String?      @unique(map: "uk_users_email") @db.VarChar(150)
  avatarUrl        String?      @map("avatar_url") @db.VarChar(512)
  passwordHash     String?      @map("password_hash") @db.VarChar(255)
  preferredLanguage String?     @default("English") @map("preferred_language") @db.VarChar(30)
  status           UserStatus   @default(ACTIVE)
  phoneVerifiedAt  DateTime?    @map("phone_verified_at")
  createdAt        DateTime     @default(now()) @map("created_at")
  updatedAt        DateTime     @updatedAt @map("updated_at")

  sessions         UserSession[]
  permissions      UserPermission[]
  ownedBusinesses  BusinessOwner[]
  staffMemberships BusinessStaff[]
  enquiries        Enquiry[]
  reviews          Review[]
  claims           BusinessClaim[]
  auditLogs        AuditLog[]

  @@map("users")
}

model UserSession {
  id               String    @id @default(uuid()) @db.VarChar(36)
  userId           String    @map("user_id") @db.VarChar(36)
  refreshTokenHash String    @map("refresh_token_hash") @db.VarChar(255)
  deviceInfo       String?   @map("device_info") @db.VarChar(255)
  ipAddress        String?   @map("ip_address") @db.VarChar(45)
  expiresAt        DateTime  @map("expires_at")
  revokedAt        DateTime? @map("revoked_at")
  createdAt        DateTime  @default(now()) @map("created_at")

  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([refreshTokenHash], map: "idx_sessions_token_hash")
  @@map("user_sessions")
}

enum OtpPurpose {
  LOGIN
  CLAIM_BIZ
  SENSITIVE_ACTION
}

model OtpChallenge {
  id            String     @id @default(uuid()) @db.VarChar(36)
  phoneNumber   String     @map("phone_number") @db.VarChar(15)
  otpCodeHash   String     @map("otp_code_hash") @db.VarChar(255)
  attemptsCount Int        @default(0) @map("attempts_count")
  purpose       OtpPurpose @default(LOGIN)
  expiresAt     DateTime   @map("expires_at")
  verifiedAt    DateTime?  @map("verified_at")
  createdAt     DateTime   @default(now()) @map("created_at")

  @@index([phoneNumber], map: "idx_otp_phone")
  @@map("otp_challenges")
}

model Role {
  id          String           @id @default(uuid()) @db.VarChar(36)
  name        String           @unique(map: "uk_roles_name") @db.VarChar(50) // CUSTOMER, VENDOR_OWNER, SUPER_ADMIN
  description String?          @db.VarChar(255)
  permissions UserPermission[]

  @@map("roles")
}

model UserPermission {
  id         String   @id @default(uuid()) @db.VarChar(36)
  userId     String   @map("user_id") @db.VarChar(36)
  roleId     String   @map("role_id") @db.VarChar(36)
  resourceId String?  @map("resource_id") @db.VarChar(36)

  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role       Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@map("user_permissions")
}

// -------------------------------------------------------------
// 2. GEOGRAPHY & LOCATIONS
// -------------------------------------------------------------

model State {
  id        String     @id @default(uuid()) @db.VarChar(36)
  name      String     @unique @db.VarChar(100) // e.g. Andhra Pradesh
  code      String     @unique @db.VarChar(10)  // AP
  isActive  Boolean    @default(true) @map("is_active")
  districts District[]

  @@map("states")
}

model District {
  id       String   @id @default(uuid()) @db.VarChar(36)
  stateId  String   @map("state_id") @db.VarChar(36)
  name     String   @db.VarChar(100) // e.g. Krishna, Guntur
  state    State    @relation(fields: [stateId], references: [id], onDelete: Restrict)
  cities   City[]

  @@map("districts")
}

model City {
  id          String             @id @default(uuid()) @db.VarChar(36)
  districtId  String             @map("district_id") @db.VarChar(36)
  name        String             @db.VarChar(100) // Vijayawada, Guntur
  slug        String             @unique(map: "uk_cities_slug") @db.VarChar(100)
  latitude    Decimal            @db.Decimal(10, 7)
  longitude   Decimal            @db.Decimal(10, 7)
  isActive    Boolean            @default(true) @map("is_active")
  district    District           @relation(fields: [districtId], references: [id], onDelete: Restrict)
  localities  Locality[]
  locations   BusinessLocation[]

  @@map("cities")
}

model Locality {
  id          String             @id @default(uuid()) @db.VarChar(36)
  cityId      String             @map("city_id") @db.VarChar(36)
  name        String             @db.VarChar(100) // Nahamar, Benz Circle
  slug        String             @db.VarChar(100)
  pincode     String?            @db.VarChar(10)
  latitude    Decimal            @db.Decimal(10, 7)
  longitude   Decimal            @db.Decimal(10, 7)
  isActive    Boolean            @default(true) @map("is_active")
  city        City               @relation(fields: [cityId], references: [id], onDelete: Restrict)
  locations   BusinessLocation[]

  @@index([cityId, slug], map: "idx_localities_city_slug")
  @@map("localities")
}

// -------------------------------------------------------------
// 3. CATEGORIES & TAXONOMIES
// -------------------------------------------------------------

model Category {
  id              String             @id @default(uuid()) @db.VarChar(36)
  parentId        String?            @map("parent_id") @db.VarChar(36)
  name            String             @db.VarChar(100)
  slug            String             @unique(map: "uk_categories_slug") @db.VarChar(100)
  iconUrl         String?            @map("icon_url") @db.VarChar(512)
  metaTitle       String?            @map("meta_title") @db.VarChar(200)
  metaDescription String?            @map("meta_description") @db.VarChar(300)
  sortOrder       Int                @default(0) @map("sort_order")
  isActive        Boolean            @default(true) @map("is_active")

  parent          Category?          @relation("CategoryHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children        Category[]         @relation("CategoryHierarchy")
  services        Service[]
  businesses      BusinessCategory[]

  @@map("categories")
}

model Service {
  id         String   @id @default(uuid()) @db.VarChar(36)
  categoryId String   @map("category_id") @db.VarChar(36)
  name       String   @db.VarChar(100)
  slug       String   @db.VarChar(100)
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@map("services")
}

// -------------------------------------------------------------
// 4. BUSINESS CORE & BRANCHES
// -------------------------------------------------------------

enum BusinessStatus {
  DRAFT
  PENDING
  APPROVED
  REJECTED
  SUSPENDED
}

model Business {
  id               String             @id @default(uuid()) @db.VarChar(36)
  name             String             @db.VarChar(150)
  legalName        String?            @map("legal_name") @db.VarChar(200)
  slug             String             @unique(map: "uk_businesses_slug") @db.VarChar(200)
  description      String?            @db.Text
  primaryPhone     String             @map("primary_phone") @db.VarChar(15)
  whatsappNumber   String?            @map("whatsapp_number") @db.VarChar(15)
  supportEmail     String?            @map("support_email") @db.VarChar(150)
  logoUrl          String?            @map("logo_url") @db.VarChar(512)
  coverImageUrl    String?            @map("cover_image_url") @db.VarChar(512)
  status           BusinessStatus     @default(PENDING)
  isVerified       Boolean            @default(false) @map("is_verified")
  verifiedAt       DateTime?          @map("verified_at")
  isFeatured       Boolean            @default(false) @map("is_featured")
  featuredUntil    DateTime?          @map("featured_until")
  averageRating    Decimal            @default(0.00) @map("average_rating") @db.Decimal(3, 2)
  totalReviews     Int                @default(0) @map("total_reviews")
  totalEnquiries   Int                @default(0) @map("total_enquiries")
  createdAt        DateTime           @default(now()) @map("created_at")
  updatedAt        DateTime           @updatedAt @map("updated_at")

  owners           BusinessOwner[]
  staff            BusinessStaff[]
  locations        BusinessLocation[]
  categories       BusinessCategory[]
  hours            BusinessHour[]
  media            BusinessMedia[]
  enquiries        Enquiry[]
  reviews          Review[]
  subscriptions    Subscription[]
  verificationReqs VerificationRequest[]
  claims           BusinessClaim[]

  @@index([status, isVerified, averageRating], map: "idx_biz_search")
  @@map("businesses")
}

enum OwnershipType {
  FOUNDER
  CLAIMANT
  PARTNER
}

model BusinessOwner {
  id            String        @id @default(uuid()) @db.VarChar(36)
  businessId    String        @map("business_id") @db.VarChar(36)
  userId        String        @map("user_id") @db.VarChar(36)
  ownershipType OwnershipType @default(FOUNDER) @map("ownership_type")
  isPrimary     Boolean       @default(true) @map("is_primary")

  business      Business      @relation(fields: [businessId], references: [id], onDelete: Cascade)
  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([businessId, userId], map: "uk_biz_owner")
  @@map("business_owners")
}

enum StaffRole {
  MANAGER
  COORDINATOR
  STAFF
}

enum StaffStatus {
  ACTIVE
  INVITED
  INACTIVE
}

model BusinessStaff {
  id          String             @id @default(uuid()) @db.VarChar(36)
  businessId  String             @map("business_id") @db.VarChar(36)
  userId      String             @map("user_id") @db.VarChar(36)
  role        StaffRole          @default(STAFF)
  status      StaffStatus        @default(ACTIVE)

  business    Business           @relation(fields: [businessId], references: [id], onDelete: Cascade)
  user        User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  assignments EnquiryAssignment[]

  @@unique([businessId, userId], map: "uk_biz_staff")
  @@map("business_staff")
}

model BusinessLocation {
  id           String    @id @default(uuid()) @db.VarChar(36)
  businessId   String    @map("business_id") @db.VarChar(36)
  cityId       String    @map("city_id") @db.VarChar(36)
  localityId   String?   @map("locality_id") @db.VarChar(36)
  addressLine1 String    @map("address_line1") @db.VarChar(255)
  landmark     String?   @db.VarChar(150)
  pincode      String    @db.VarChar(10)
  latitude     Decimal   @db.Decimal(10, 7)
  longitude    Decimal   @db.Decimal(10, 7)
  isPrimary    Boolean   @default(true) @map("is_primary")

  business     Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  city         City      @relation(fields: [cityId], references: [id], onDelete: Restrict)
  locality     Locality? @relation(fields: [localityId], references: [id], onDelete: SetNull)

  @@index([cityId, localityId], map: "idx_biz_loc_city")
  @@map("business_locations")
}

model BusinessCategory {
  id         String   @id @default(uuid()) @db.VarChar(36)
  businessId String   @map("business_id") @db.VarChar(36)
  categoryId String   @map("category_id") @db.VarChar(36)
  isPrimary  Boolean  @default(false) @map("is_primary")

  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([businessId, categoryId], map: "uk_biz_category")
  @@map("business_categories")
}

model BusinessHour {
  id         String   @id @default(uuid()) @db.VarChar(36)
  businessId String   @map("business_id") @db.VarChar(36)
  dayOfWeek  Int      @map("day_of_week") // 0=Sunday, 6=Saturday
  opensAt    String?  @map("opens_at") @db.VarChar(8) // "09:00:00"
  closesAt   String?  @map("closes_at") @db.VarChar(8) // "21:00:00"
  isClosed   Boolean  @default(false) @map("is_closed")

  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@map("business_hours")
}

enum MediaType {
  IMAGE
  LOGO
  COVER
  DOCUMENT
}

model BusinessMedia {
  id         String    @id @default(uuid()) @db.VarChar(36)
  businessId String    @map("business_id") @db.VarChar(36)
  mediaUrl   String    @map("media_url") @db.VarChar(512)
  mediaType  MediaType @default(IMAGE) @map("media_type")
  sortOrder  Int       @default(0) @map("sort_order")

  business   Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@map("business_media")
}

// -------------------------------------------------------------
// 5. ENQUIRIES & LEADS LIFECYCLE
// -------------------------------------------------------------

enum EnquiryStatus {
  NEW
  CONTACTED
  IN_PROGRESS
  CONVERTED
  CLOSED_LOST
}

enum EnquiryPriority {
  NORMAL
  HIGH
  URGENT
}

model Enquiry {
  id            String             @id @default(uuid()) @db.VarChar(36)
  referenceNo   String             @unique(map: "uk_enq_ref") @map("reference_no") @db.VarChar(20)
  businessId    String             @map("business_id") @db.VarChar(36)
  customerId    String             @map("customer_id") @db.VarChar(36)
  customerName  String             @map("customer_name") @db.VarChar(100)
  customerPhone String             @map("customer_phone") @db.VarChar(15)
  message       String             @db.Text
  status        EnquiryStatus      @default(NEW)
  priority      EnquiryPriority    @default(NORMAL)
  createdAt     DateTime           @default(now()) @map("created_at")
  updatedAt     DateTime           @updatedAt @map("updated_at")

  business      Business           @relation(fields: [businessId], references: [id], onDelete: Cascade)
  customer      User               @relation(fields: [customerId], references: [id], onDelete: Cascade)
  events        EnquiryEvent[]
  assignments   EnquiryAssignment[]

  @@index([businessId, status], map: "idx_enquiry_biz_status")
  @@map("enquiries")
}

model EnquiryEvent {
  id             String         @id @default(uuid()) @db.VarChar(36)
  enquiryId      String         @map("enquiry_id") @db.VarChar(36)
  actorUserId    String?        @map("actor_user_id") @db.VarChar(36)
  previousStatus EnquiryStatus? @map("previous_status")
  newStatus      EnquiryStatus  @map("new_status")
  notes          String?        @db.Text
  createdAt      DateTime       @default(now()) @map("created_at")

  enquiry        Enquiry        @relation(fields: [enquiryId], references: [id], onDelete: Cascade)

  @@map("enquiry_events")
}

model EnquiryAssignment {
  id              String        @id @default(uuid()) @db.VarChar(36)
  enquiryId       String        @map("enquiry_id") @db.VarChar(36)
  staffId         String        @map("staff_id") @db.VarChar(36)
  assignedByUserId String       @map("assigned_by_user_id") @db.VarChar(36)
  assignedAt      DateTime      @default(now()) @map("assigned_at")

  enquiry         Enquiry       @relation(fields: [enquiryId], references: [id], onDelete: Cascade)
  staff           BusinessStaff @relation(fields: [staffId], references: [id], onDelete: Cascade)

  @@map("enquiry_assignments")
}

// -------------------------------------------------------------
// 6. REVIEWS & RATINGS
// -------------------------------------------------------------

enum ReviewStatus {
  PENDING
  APPROVED
  FLAGGED
  REMOVED
}

model Review {
  id         String       @id @default(uuid()) @db.VarChar(36)
  businessId String       @map("business_id") @db.VarChar(36)
  userId     String       @map("user_id") @db.VarChar(36)
  rating     Int          @db.TinyInt // 1 to 5
  reviewText String?      @map("review_text") @db.Text
  status     ReviewStatus @default(APPROVED)
  createdAt  DateTime     @default(now()) @map("created_at")
  updatedAt  DateTime     @updatedAt @map("updated_at")

  business   Business     @relation(fields: [businessId], references: [id], onDelete: Cascade)
  user       User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([businessId, status], map: "idx_reviews_biz")
  @@map("reviews")
}

// -------------------------------------------------------------
// 7. VERIFICATION & CLAIMS
// -------------------------------------------------------------

enum VerificationStatus {
  PENDING
  UNDER_REVIEW
  APPROVED
  REJECTED
}

model VerificationRequest {
  id               String             @id @default(uuid()) @db.VarChar(36)
  businessId       String             @map("business_id") @db.VarChar(36)
  submittedByUserId String            @map("submitted_by_user_id") @db.VarChar(36)
  reviewedByAdminId String?           @map("reviewed_by_admin_id") @db.VarChar(36)
  status           VerificationStatus @default(PENDING)
  rejectionReason  String?            @map("rejection_reason") @db.Text
  createdAt        DateTime           @default(now()) @map("created_at")
  reviewedAt       DateTime?          @map("reviewed_at")

  business         Business           @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@map("verification_requests")
}

model BusinessClaim {
  id              String             @id @default(uuid()) @db.VarChar(36)
  businessId      String             @map("business_id") @db.VarChar(36)
  claimantUserId  String             @map("claimant_user_id") @db.VarChar(36)
  status          VerificationStatus @default(PENDING)
  notes           String?            @db.Text
  createdAt       DateTime           @default(now()) @map("created_at")
  reviewedAt      DateTime?          @map("reviewed_at")

  business        Business           @relation(fields: [businessId], references: [id], onDelete: Cascade)
  claimant        User               @relation(fields: [claimantUserId], references: [id], onDelete: Cascade)

  @@map("business_claims")
}

// -------------------------------------------------------------
// 8. SUBSCRIPTIONS & MONETIZATION
// -------------------------------------------------------------

enum PlanTier {
  FREE
  HELLO_PLUS
  HELLO_PRO
  HELLO_FEATURED
}

model SubscriptionPlan {
  id               String         @id @default(uuid()) @db.VarChar(36)
  name             PlanTier       @unique @map("name")
  priceInrCents    Int            @map("price_inr_cents") // 29900 = ₹299
  billingCycleDays Int            @default(30) @map("billing_cycle_days")
  featuresJson     String?        @map("features_json") @db.Text
  isActive         Boolean        @default(true) @map("is_active")

  subscriptions    Subscription[]

  @@map("subscription_plans")
}

enum SubscriptionStatus {
  ACTIVE
  EXPIRED
  CANCELLED
  GRACE_PERIOD
}

model Subscription {
  id             String             @id @default(uuid()) @db.VarChar(36)
  businessId     String             @map("business_id") @db.VarChar(36)
  planId         String             @map("plan_id") @db.VarChar(36)
  status         SubscriptionStatus @default(ACTIVE)
  startsAt       DateTime           @map("starts_at")
  endsAt         DateTime           @map("ends_at")

  business       Business           @relation(fields: [businessId], references: [id], onDelete: Cascade)
  plan           SubscriptionPlan   @relation(fields: [planId], references: [id], onDelete: Restrict)

  @@map("subscriptions")
}

// -------------------------------------------------------------
// 9. AUDIT LOGS
// -------------------------------------------------------------

model AuditLog {
  id           String    @id @default(uuid()) @db.VarChar(36)
  actorUserId  String?   @map("actor_user_id") @db.VarChar(36)
  action       String    @db.VarChar(100) // KYC_APPROVE, BUSINESS_SUSPEND, etc.
  entityName   String    @map("entity_name") @db.VarChar(50)
  entityId     String    @map("entity_id") @db.VarChar(36)
  payloadBefore String?  @map("payload_before") @db.Text
  payloadAfter  String?  @map("payload_after") @db.Text
  ipAddress    String?   @map("ip_address") @db.VarChar(45)
  createdAt    DateTime  @default(now()) @map("created_at")

  actor        User?     @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([action, entityName], map: "idx_audit_action")
  @@map("audit_logs")
}

